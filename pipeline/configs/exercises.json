    "driver": ["knee_angle_r", "knee_angle_l"],
    "min_prominence_deg": 25.0,
    "min_rep_s": 1.0,
    "key": ["knee_angle_r", "knee_angle_l", "hip_flexion_r", "hip_flexion_l", "ankle_angle_r", "ankle_angle_l",
            "hip_adduction_r", "hip_adduction_l", "pelvis_tilt", "lumbar_total.sagittal",
            "torso.sagittal", "torso.frontal", "pelvis.frontal", "knee_fppa_r", "knee_fppa_l"]
  },
  "sit_to_stand": {
    "driver": ["hip_flexion_r", "hip_flexion_l"],
    "min_prominence_deg": 30.0,
